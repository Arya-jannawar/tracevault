# ---- TraceVault local configuration (copy to .env) ----
# All defaults are safe for local development. No secrets are committed.

# Workspace label shown in the UI
TRACEVAULT_WORKSPACE=default

# PostgreSQL (authoritative registry) - matches compose.yaml
DATABASE_URL=postgresql+psycopg://tracevault:tracevault@127.0.0.1:5433/tracevault

# Qdrant (vectors) and Redis (answer cache)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=tracevault
REDIS_URL=redis://127.0.0.1:6379/0

# Session signing (REQUIRED for the API; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=
SESSION_TTL_MINUTES=720

# Bootstrap operator (if password empty, bootstrap generates one and prints it)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- AI adapters -----------------------------------------------------------
# Embeddings:
#   sentence-transformers  -> real local MiniLM embeddings (downloads ~90MB model)
#   deterministic          -> hashed demo embeddings, clearly labeled in the UI;
#                             for demos/tests only, never for research results
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM:
#   extractive         -> no generative model; answers cite retrieved excerpts
#   openai-compatible  -> any OpenAI-compatible local server
#                         (Ollama: http://127.0.0.1:11434/v1, llama.cpp, vLLM...)
LLM_PROVIDER=extractive
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=

# ---- Feature flags ---------------------------------------------------------
ENABLE_SELECTIVE_REPAIR=false
ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.92

# ---- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_CHUNKS_PER_DOC=2000

# Seed the synthetic demo corpus on API startup (safe to repeat)
SEED_ON_START=true
